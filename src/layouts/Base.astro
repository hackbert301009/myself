---
import '../styles/global.css';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DetectionBG from '../components/DetectionBG.astro';

interface Props {
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title = t('meta.title'), description = t('meta.desc') } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const siteName = 'Albert Heruth';

// Per-page hreflang. Derive the language-independent slug the same way Nav does,
// then emit alternates only for routes that actually exist in both languages —
// the legal pages are German-only and get x-default alone.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const slug = lang === 'en' ? path.replace(/^\/en/, '') || '/' : path;
const LOCALIZED = ['/', '/projekte', '/zertifikate', '/herz', '/kontakt'];
const hasAlternates = LOCALIZED.includes(slug);
// Trailing slash, so these match the canonical URL byte for byte.
const deHref = new URL(slug === '/' ? '/' : `${slug}/`, Astro.site).href;
const enHref = new URL(slug === '/' ? '/en/' : `/en${slug}/`, Astro.site).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Albert Heruth',
  url: Astro.site?.href,
  image: ogImage,
  // No jobTitle: these are fields of work, not a professional title.
  knowsAbout: ['Applied Mathematics', 'Machine Learning', 'Computer Vision', 'Embedded Systems'],
  description: t('meta.desc'),
  sameAs: [
    'https://github.com/hackbert301009',
    'https://www.linkedin.com/in/albert-heruth-37aa74379/',
    'https://sterilvision.de',
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <!-- Set theme before paint to avoid a flash of the wrong color scheme. -->
    <script is:inline>
      (() => {
        try {
          if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.classList.add('dark');
          }
        } catch (_) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Albert Heruth" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Hreflang -->
    {
      hasAlternates && (
        <>
          <link rel="alternate" hreflang="de" href={deHref} />
          <link rel="alternate" hreflang="en" href={enHref} />
        </>
      )
    }
    <link rel="alternate" hreflang="x-default" href={deHref} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- Scroll-reveal starts at opacity 0 and is switched on by JS below.
         Without JS that would leave most of every page blank, so opt out. -->
    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <DetectionBG />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-surface-2 focus:px-4 focus:py-2 focus:text-text"
      >{t('a11y.skip')}</a
    >
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <div
      id="egg-toast"
      class="egg-toast"
      role="status"
      aria-live="polite"
      data-on={t('easter.on')}
      data-off={t('easter.off')}
    >
    </div>

    <!-- Easter egg: Konami code toggles a night-vision scan of the page -->
    <script is:inline>
      (() => {
        if (window.__eggBound) return;
        window.__eggBound = true;
        const seq = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
        let idx = 0, tt;
        const toast = () => document.getElementById('egg-toast');
        const show = (msg) => {
          const el = toast(); if (!el) return;
          el.textContent = msg; el.classList.add('show');
          clearTimeout(tt); tt = setTimeout(() => el.classList.remove('show'), 2400);
        };
        addEventListener('keydown', (e) => {
          const k = e.key.length === 1 ? e.key.toLowerCase() : e.key;
          idx = k === seq[idx] ? idx + 1 : (k === seq[0] ? 1 : 0);
          if (idx === seq.length) {
            idx = 0;
            const on = document.documentElement.classList.toggle('scan-mode');
            const el = toast();
            show(on ? el?.dataset.on : el?.dataset.off);
          }
        });
      })();
    </script>

    <script>
      // Reveal-on-scroll: add .is-visible when elements enter the viewport.
      const reveal = () => {
        const els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      };
      reveal();
      document.addEventListener('astro:page-load', reveal);
    </script>
  </body>
</html>
