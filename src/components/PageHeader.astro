---
interface Props {
  label: string;
  title: string;
  lead?: string;
}
const { label, title, lead } = Astro.props;
---

<header class="px-5 pt-32 pb-14 text-center">
  <div class="mx-auto max-w-3xl">
    <p class="label-mono mb-3">{label}</p>
    <h1 class="text-4xl font-semibold tracking-tight text-text sm:text-5xl">{title}</h1>
    {lead && <p class="mx-auto mt-4 max-w-2xl text-lg text-muted">{lead}</p>}
  </div>
</header>
