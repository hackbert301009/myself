---
// Global animated background: drifting object-detection boxes that frame real
// objects (line-art), with labels. Sits behind all content (z-index -1),
// theme-aware, fades toward the centre so text stays readable.
---

<canvas id="det-bg" aria-hidden="true"></canvas>

<style>
  #det-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
</style>

<script>
  function initDetectionBG() {
    const canvas = document.getElementById('det-bg') as HTMLCanvasElement | null;
    if (!canvas || (canvas as any).__init) return;
    (canvas as any).__init = true;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Real objects (COCO-style), each a 24x24 line-art path.
    const OBJECTS = [
      { label: 'laptop', d: 'M4 6h16v9H4zM2 18h20l-1 1H3z' },
      { label: 'cup', d: 'M6 8h10v5a4 4 0 0 1-4 4h-2a4 4 0 0 1-4-4zM16 9h2a2 2 0 0 1 0 4h-2' },
      { label: 'bottle', d: 'M10 3h4v3l1 3v9a2 2 0 0 1-2 2h-2a2 2 0 0 1-2-2V9l1-3z' },
      { label: 'book', d: 'M5 4h11a1 1 0 0 1 1 1v15a1 1 0 0 0-1-1H5zM8 8h6' },
      { label: 'cell phone', d: 'M8 3h8a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM10 18h4' },
      { label: 'chair', d: 'M6 4v8m12-8v8M5 12h14M8 12v8M16 12v8M8 9h8' },
      { label: 'plant', d: 'M12 21v-7M12 14c-3 0-5-2-5-5 3 0 5 2 5 5zM12 14c3 0 5-2 5-5-3 0-5 2-5 5M8 21h8' },
      { label: 'keyboard', d: 'M3 7h18v10H3zM6 10h.01M9 10h.01M12 10h.01M15 10h.01M18 10h.01M8 14h8' },
      { label: 'mouse', d: 'M12 3a5 5 0 0 1 5 5v6a5 5 0 0 1-10 0V8a5 5 0 0 1 5-5zM12 7v3' },
      { label: 'clock', d: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 7v5l3 2' },
      { label: 'camera', d: 'M4 7h4l1-2h6l1 2h4v12H4zM12 16a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z' },
      { label: 'tv', d: 'M3 5h18v11H3zM9 20h6M12 16v4' },
      { label: 'person', d: 'M12 7a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM5 21a7 7 0 0 1 14 0' },
      { label: 'bird', d: 'M4 15c4 0 7-3 7-7 2 3 5 3 8 1-1 4-4 8-9 8-3 0-5-1-6-2zM11 8l-1-2' },
    ];

    let W = 0, H = 0, dpr = 1;
    let rgb = { r: 0, g: 113, b: 227 };
    let darkBoost = 1;

    const readTheme = () => {
      const cs = getComputedStyle(document.documentElement);
      const hex = (cs.getPropertyValue('--color-accent') || '#0071e3').trim().replace('#', '');
      rgb = {
        r: parseInt(hex.substring(0, 2), 16) || 0,
        g: parseInt(hex.substring(2, 4), 16) || 113,
        b: parseInt(hex.substring(4, 6), 16) || 227,
      };
      darkBoost = document.documentElement.classList.contains('dark') ? 1.15 : 1;
    };
    const col = (a: number) => `rgba(${rgb.r},${rgb.g},${rgb.b},${a * darkBoost})`;

    type Box = { x: number; y: number; w: number; h: number; vx: number; vy: number; obj: typeof OBJECTS[number]; conf: string; path: Path2D };
    let boxes: Box[] = [];

    const build = () => {
      const count = Math.max(6, Math.min(12, Math.round((W * H) / 280000)));
      boxes = Array.from({ length: count }, () => {
        const w = 108 + Math.random() * 150;
        const h = 88 + Math.random() * 120;
        const obj = OBJECTS[(Math.random() * OBJECTS.length) | 0];
        return {
          x: Math.random() * (W - w),
          y: Math.random() * (H - h),
          w, h,
          vx: (Math.random() - 0.5) * 0.2,
          vy: (Math.random() - 0.5) * 0.2,
          obj,
          conf: (0.86 + Math.random() * 0.13).toFixed(2),
          path: new Path2D(obj.d),
        };
      });
    };

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = window.innerWidth;
      H = window.innerHeight;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      build();
    };

    const bracket = (x: number, y: number, w: number, h: number, a: number) => {
      const L = 12;
      ctx.strokeStyle = col(0.5 * a);
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(x, y + L); ctx.lineTo(x, y); ctx.lineTo(x + L, y);
      ctx.moveTo(x + w - L, y); ctx.lineTo(x + w, y); ctx.lineTo(x + w, y + L);
      ctx.moveTo(x, y + h - L); ctx.lineTo(x, y + h); ctx.lineTo(x + L, y + h);
      ctx.moveTo(x + w - L, y + h); ctx.lineTo(x + w, y + h); ctx.lineTo(x + w, y + h - L);
      ctx.stroke();
    };

    const draw = () => {
      ctx.clearRect(0, 0, W, H);
      ctx.font = '11px ui-monospace, SFMono-Regular, Menlo, monospace';
      ctx.textBaseline = 'middle';
      const cx = W / 2;
      for (const b of boxes) {
        // Fade toward the vertical reading column so text stays clear.
        const dist = Math.min(1, Math.abs(b.x + b.w / 2 - cx) / (W * 0.5));
        const a = 0.2 + 0.8 * dist;

        // thin frame
        ctx.strokeStyle = col(0.22 * a);
        ctx.lineWidth = 1;
        ctx.strokeRect(b.x, b.y, b.w, b.h);
        bracket(b.x, b.y, b.w, b.h, a);

        // object line-art, centred in the box
        const size = Math.min(b.w, b.h) * 0.52;
        const s = size / 24;
        ctx.save();
        ctx.translate(b.x + b.w / 2 - size / 2, b.y + b.h / 2 - size / 2);
        ctx.scale(s, s);
        ctx.lineJoin = 'round'; ctx.lineCap = 'round';
        ctx.lineWidth = 1.5 / s;
        ctx.strokeStyle = col(0.45 * a);
        ctx.stroke(b.path);
        ctx.restore();

        // label
        const text = `${b.obj.label} ${b.conf}`;
        const tw = ctx.measureText(text).width;
        ctx.fillStyle = col(0.1 * a);
        ctx.fillRect(b.x, b.y - 16, tw + 12, 15);
        ctx.fillStyle = col(0.85 * a);
        ctx.fillText(text, b.x + 6, b.y - 8);
      }
    };

    let raf = 0;
    const step = () => {
      for (const b of boxes) {
        b.x += b.vx; b.y += b.vy;
        if (b.x < -b.w) b.x = W; else if (b.x > W) b.x = -b.w;
        if (b.y < -b.h) b.y = H; else if (b.y > H) b.y = -b.h;
      }
      draw();
      raf = requestAnimationFrame(step);
    };

    readTheme();
    resize();
    if (reduce) draw(); else step();

    let to: number;
    window.addEventListener('resize', () => { clearTimeout(to); to = window.setTimeout(resize, 200); });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { cancelAnimationFrame(raf); raf = 0; }
      else if (!reduce && !raf) step();
    });
    new MutationObserver(() => { readTheme(); if (reduce) draw(); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  }

  initDetectionBG();
  document.addEventListener('astro:page-load', initDetectionBG);
</script>
