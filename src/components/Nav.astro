---
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Current slug without the /en prefix, for active-state + language swap.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const slug = lang === 'en' ? path.replace(/^\/en/, '') || '/' : path;

const lp = (p: string) => localizedPath(p, lang);
const isActive = (p: string) => slug === p || (p !== '/' && slug.startsWith(p));

const primary = [
  { slug: '/projekte', label: t('nav.projects') },
  { slug: '/labs', label: t('nav.labs') },
  { slug: '/aktuelles', label: t('nav.news') },
];
const person = [
  { slug: '/ueber-mich', label: t('nav.about') },
  { slug: '/lebenslauf', label: t('nav.cv') },
  { slug: '/zertifikate', label: t('nav.certificates') },
  { slug: '/ziele', label: t('nav.goals') },
];

const otherLang = lang === 'de' ? 'en' : 'de';
const otherHref = localizedPath(slug, otherLang);
const personActive = person.some((p) => isActive(p.slug));
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-40 transition-[background-color,border-color,backdrop-filter] duration-500"
>
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
    <a href={lp('/')} class="group flex items-center gap-2.5" aria-label="Albert Heruth — Home">
      <span
        class="grid h-9 w-9 place-items-center rounded-lg border border-line-strong bg-surface-2 font-mono text-sm font-bold text-accent transition-colors group-hover:border-accent"
        >ah</span
      >
      <span class="hidden font-mono text-sm tracking-tight text-muted sm:inline">
        albert<span class="text-accent">.</span>heruth
      </span>
    </a>

    <!-- Desktop links -->
    <div class="hidden items-center gap-1 md:flex">
      {
        primary.map((l) => (
          <a
            href={lp(l.slug)}
            class:list={[
              'rounded-lg px-3 py-2 text-sm transition-colors hover:text-text',
              isActive(l.slug) ? 'text-accent' : 'text-muted',
            ]}
          >
            {l.label}
          </a>
        ))
      }
      <!-- Profil dropdown (CSS hover + focus-within) -->
      <div class="group relative">
        <button
          class:list={[
            'flex items-center gap-1 rounded-lg px-3 py-2 text-sm transition-colors hover:text-text',
            personActive ? 'text-accent' : 'text-muted',
          ]}
          aria-haspopup="true"
        >
          {t('nav.person')}
          <svg class="h-3 w-3 transition-transform group-hover:rotate-180" viewBox="0 0 12 12" fill="none">
            <path d="M3 4.5 6 7.5 9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </button>
        <div
          class="invisible absolute right-0 top-full w-52 translate-y-1 pt-2 opacity-0 transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
        >
          <div class="overflow-hidden rounded-xl border border-line bg-surface-2/95 p-1.5 backdrop-blur-md shadow-2xl shadow-black/40">
            {
              person.map((l) => (
                <a
                  href={lp(l.slug)}
                  class:list={[
                    'block rounded-lg px-3 py-2 text-sm transition-colors hover:bg-surface hover:text-text',
                    isActive(l.slug) ? 'text-accent' : 'text-muted',
                  ]}
                >
                  {l.label}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <a
        href={otherHref}
        class="rounded-lg border border-line px-2.5 py-1.5 font-mono text-xs uppercase tracking-widest text-muted transition-colors hover:border-line-strong hover:text-text"
        aria-label={`Switch language to ${otherLang.toUpperCase()}`}
      >
        {lang === 'de' ? 'EN' : 'DE'}
      </a>
      <a
        href={lp('/kontakt')}
        class="hidden rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-ink transition-[filter] hover:brightness-110 sm:inline-block"
      >
        {t('nav.cta')}
      </a>
      <!-- Mobile hamburger -->
      <button
        id="nav-toggle"
        class="grid h-9 w-9 place-items-center rounded-lg border border-line text-muted md:hidden"
        aria-label="Menu"
        aria-expanded="false"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="nav-mobile" class="hidden border-t border-line bg-ink/95 backdrop-blur-md md:hidden">
    <div class="mx-auto flex max-w-6xl flex-col gap-1 px-5 py-4">
      {
        [...primary, ...person].map((l) => (
          <a
            href={lp(l.slug)}
            class:list={[
              'rounded-lg px-3 py-2.5 text-sm transition-colors',
              isActive(l.slug) ? 'text-accent' : 'text-muted hover:text-text',
            ]}
          >
            {l.label}
          </a>
        ))
      }
      <a href={lp('/kontakt')} class="mt-2 rounded-lg bg-accent px-3 py-2.5 text-center text-sm font-semibold text-ink">
        {t('nav.cta')}
      </a>
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById('site-nav');
  const onScroll = () => {
    if (!nav) return;
    const s = window.scrollY > 24;
    nav.classList.toggle('bg-ink/80', s);
    nav.classList.toggle('backdrop-blur-md', s);
    nav.classList.toggle('border-b', s);
    nav.classList.toggle('border-line', s);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const toggle = document.getElementById('nav-toggle');
  const mobile = document.getElementById('nav-mobile');
  toggle?.addEventListener('click', () => {
    const open = mobile?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(open === false));
  });
</script>
