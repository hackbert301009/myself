---
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const slug = lang === 'en' ? path.replace(/^\/en/, '') || '/' : path;

const lp = (p: string) => localizedPath(p, lang);
const isActive = (p: string) => slug === p || (p !== '/' && slug.startsWith(p));

const links = [
  { slug: '/projekte', label: t('nav.projects') },
  { slug: '/kontakt', label: t('nav.contact') },
];

const otherLang = lang === 'de' ? 'en' : 'de';
const otherHref = localizedPath(slug, otherLang);
---

<header class="glass fixed inset-x-0 top-0 z-40 border-b border-line">
  <nav class="mx-auto flex h-14 max-w-5xl items-center justify-between px-5">
    <a href={lp('/')} class="press text-[0.95rem] font-semibold tracking-tight text-text" aria-label="Albert Heruth — Home">
      Albert Heruth
    </a>

    <div class="flex items-center gap-1">
      <div class="hidden items-center gap-1 sm:flex">
        {
          links.map((l) => (
            <a
              href={lp(l.slug)}
              class:list={[
                'rounded-full px-3.5 py-1.5 text-sm transition-colors',
                isActive(l.slug) ? 'text-accent' : 'text-muted hover:text-text',
              ]}
            >
              {l.label}
            </a>
          ))
        }
      </div>

      <!-- Language -->
      <a
        href={otherHref}
        class="press rounded-full px-3 py-1.5 text-sm text-muted transition-colors hover:text-text"
        aria-label={`Switch language to ${otherLang.toUpperCase()}`}
      >
        {lang === 'de' ? 'EN' : 'DE'}
      </a>

      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        class="press grid h-9 w-9 place-items-center rounded-full text-muted transition-colors hover:text-text"
        aria-label="Toggle color theme"
      >
        <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<script is:inline>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch (_) {}
  });
</script>
