---
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
const lp = (p: string) => localizedPath(p, lang);

const cols = [
  {
    heading: t('footer.nav'),
    links: [
      { href: lp('/projekte'), label: t('nav.projects'), ext: false },
      { href: lp('/kontakt'), label: t('nav.contact'), ext: false },
    ],
  },
  {
    heading: t('footer.projects.ext'),
    links: [
      { href: 'https://sterilvision.de', label: 'SterilVision', ext: true },
      { href: 'https://hackbert-ai.streamlit.app/', label: 'Hackbert AI', ext: true },
    ],
  },
  {
    heading: t('footer.connect'),
    links: [
      { href: 'https://github.com/hackbert301009', label: 'GitHub', ext: true },
      { href: 'https://www.linkedin.com/in/albert-heruth-37aa74379/', label: 'LinkedIn', ext: true },
      { href: 'mailto:albert.heruth@gmail.com', label: 'E-Mail', ext: false },
    ],
  },
  {
    heading: t('footer.legal'),
    links: [
      { href: '/impressum', label: t('footer.imprint'), ext: false },
      { href: '/datenschutz', label: t('footer.privacy'), ext: false },
    ],
  },
];
---

<footer class="border-t border-line bg-surface">
  <div class="mx-auto max-w-5xl px-5 py-12">
    <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-4">
      {
        cols.map((c) => (
          <div>
            <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-faint">{c.heading}</p>
            <ul class="space-y-2">
              {c.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    target={l.ext ? '_blank' : undefined}
                    rel={l.ext ? 'noopener noreferrer' : undefined}
                    class="text-sm text-muted transition-colors hover:text-accent"
                  >
                    {l.label}
                    {l.ext && ' ↗'}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-2 border-t border-line pt-6 text-xs text-faint sm:flex-row">
      <span>© {year} Albert Heruth · {t('footer.rights')}</span>
      <span>{t('footer.built')}</span>
    </div>
  </div>
</footer>
