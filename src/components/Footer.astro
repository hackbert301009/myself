---
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
const lp = (p: string) => localizedPath(p, lang);

const navLinks = [
  { slug: '/projekte', label: t('nav.projects') },
  { slug: '/labs', label: t('nav.labs') },
  { slug: '/ueber-mich', label: t('nav.about') },
  { slug: '/lebenslauf', label: t('nav.cv') },
  { slug: '/zertifikate', label: t('nav.certificates') },
  { slug: '/aktuelles', label: t('nav.news') },
];
const socials = [
  { href: 'https://github.com/hackbert301009', label: 'GitHub' },
  { href: 'https://www.linkedin.com/in/albert-heruth-37aa74379/', label: 'LinkedIn' },
  { href: 'mailto:albert.heruth@gmail.com', label: 'E-Mail' },
];
---

<footer class="border-t border-line bg-surface/40">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <a href={lp('/')} class="flex items-center gap-2.5">
        <span class="grid h-9 w-9 place-items-center rounded-lg border border-line-strong bg-surface-2 font-mono text-sm font-bold text-accent">ah</span>
        <span class="font-mono text-sm text-muted">albert<span class="text-accent">.</span>heruth</span>
      </a>
      <p class="mt-4 max-w-sm text-sm text-muted">{t('meta.desc')}</p>
      <div class="mt-4 font-mono text-xs text-faint">
        <span class="text-accent">root@hackbert</span>:~$ <span class="text-muted">whoami → ai_engineer</span>
      </div>
    </div>

    <div>
      <p class="label-mono mb-4 !text-faint">{t('footer.nav')}</p>
      <ul class="space-y-2">
        {
          navLinks.map((l) => (
            <li>
              <a href={lp(l.slug)} class="text-sm text-muted transition-colors hover:text-accent">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="label-mono mb-4 !text-faint">{t('footer.connect')}</p>
      <ul class="space-y-2">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} rel="me noopener" class="text-sm text-muted transition-colors hover:text-accent">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-line/60">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-5 py-5 sm:flex-row">
      <span class="text-xs text-faint">© {year} Albert Heruth · {t('footer.rights')}</span>
      <span class="font-mono text-[0.65rem] tracking-widest text-faint/70">{t('footer.built')}</span>
    </div>
  </div>
</footer>
