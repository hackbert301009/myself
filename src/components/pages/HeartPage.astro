---
import { getLangFromUrl, useTranslations, pick, localizedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const lp = (p: string) => localizedPath(p, lang);

const ROSE = '#f43f5e';

const causes = [
  {
    mono: '✚', tint: ROSE,
    name: 'Ärzte ohne Grenzen',
    tag: { de: 'Medizinische Nothilfe', en: 'Medical emergency aid' },
    desc: {
      de: 'Unabhängige medizinische Hilfe weltweit — dort, wo sie am dringendsten gebraucht wird. Als angehender Medizin-CV-Entwickler liegt mir das besonders nahe.',
      en: 'Independent medical aid worldwide — where it is needed most. As someone building medical computer vision, this is close to my heart.',
    },
    url: 'https://www.aerzte-ohne-grenzen.de/spenden',
  },
  {
    mono: 'T', tint: '#0071e3',
    name: 'Die Tafeln',
    tag: { de: 'Gegen Armut & Verschwendung', en: 'Against poverty & waste' },
    desc: {
      de: 'Retten gute Lebensmittel und geben sie an Menschen in Not weiter — praktisch, lokal und wirkungsvoll.',
      en: 'Rescue good food and pass it to people in need — practical, local and effective.',
    },
    url: 'https://www.tafel.de/spenden',
  },
  {
    mono: 'W', tint: '#8b5cf6',
    name: 'Wikimedia / Wikipedia',
    tag: { de: 'Freies Wissen für alle', en: 'Free knowledge for all' },
    desc: {
      de: 'Wissen frei und kostenlos für jeden — die Grundlage, auf der auch ich so vieles gelernt habe.',
      en: 'Knowledge free for everyone — the foundation on which I have learned so much.',
    },
    url: 'https://spenden.wikimedia.de/',
  },
  {
    mono: 'JF', tint: '#1d9e5e',
    name: 'Stiftung Jugend forscht',
    tag: { de: 'Nachwuchs fördern', en: 'Nurturing young talent' },
    desc: {
      de: 'Gibt jungen Menschen die Bühne, ihre Ideen in Forschung und Technik umzusetzen — genau der Funke, der auch mich antreibt.',
      en: 'Gives young people a stage to turn ideas into research and technology — exactly the spark that drives me.',
    },
    url: 'https://www.jugend-forscht.de/',
  },
];

const values = [
  { icon: 'M4 19V6a2 2 0 0 1 2-2h9l5 5v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z|M9 9h4M9 13h6', title: { de: 'Bildung für alle', en: 'Education for all' }, desc: { de: 'Zugang zu Wissen darf nie eine Frage des Geldbeutels sein.', en: 'Access to knowledge should never be a matter of money.' } },
  { icon: 'M12 21s-7-4.5-9.5-9A5 5 0 0 1 12 6a5 5 0 0 1 9.5 6C19 16.5 12 21 12 21Z', title: { de: 'Technik, die hilft', en: 'Technology that helps' }, desc: { de: 'Ich baue Dinge, die Menschen einen echten Vorteil bringen — nicht nur Demos.', en: 'I build things that give people a real advantage — not just demos.' } },
  { icon: 'M12 3 4 6v6c0 5 3.5 8 8 10 4.5-2 8-5 8-10V6l-8-3Z|m9 12 2 2 4-4', title: { de: 'Ehrlichkeit & Transparenz', en: 'Honesty & transparency' }, desc: { de: 'Offener Code, offene Worte. Keine Black Boxes, wo Vertrauen zählt.', en: 'Open code, straight talk. No black boxes where trust matters.' } },
  { icon: 'M12 22c4-3 7-6 7-11a7 7 0 0 0-14 0c0 5 3 8 7 11Z', title: { de: 'Nachhaltigkeit', en: 'Sustainability' }, desc: { de: 'Effiziente Modelle, langlebige Hardware, bewusster Umgang mit Ressourcen.', en: 'Efficient models, durable hardware, mindful use of resources.' } },
  { icon: 'M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1|M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z', title: { de: 'Neugier bewahren', en: 'Stay curious' }, desc: { de: 'Immer weiter fragen, lernen, ausprobieren — das hört nie auf.', en: 'Keep asking, learning, experimenting — it never stops.' } },
  { icon: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2|M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z|M23 21v-2a4 4 0 0 0-3-3.87M16 3.13A4 4 0 0 1 16 11', title: { de: 'Menschen zuerst', en: 'People first' }, desc: { de: 'Hinter jeder Zeile Code steht ein Mensch, dem sie nützen soll.', en: 'Behind every line of code is a person it should serve.' } },
];
---

<!-- Hero with heartbeat -->
<header class="relative overflow-hidden px-5 pt-32 pb-16 text-center">
  <div class="heart-aura pointer-events-none absolute left-1/2 top-16 h-64 w-64 -translate-x-1/2"></div>
  <div class="relative mx-auto max-w-3xl">
    <div class="mb-6 flex justify-center">
      <span class="heartbeat inline-flex" style={`color:${ROSE}`}>
        <svg viewBox="0 0 24 24" class="h-16 w-16" fill="currentColor">
          <path d="M12 21s-7-4.5-9.5-9A5 5 0 0 1 12 6a5 5 0 0 1 9.5 6C19 16.5 12 21 12 21Z" />
        </svg>
      </span>
    </div>
    <p class="label-mono mb-3" style={`color:${ROSE}`}>{t('heart.label')}</p>
    <h1 class="text-4xl font-semibold tracking-tight text-text sm:text-5xl">{t('heart.title')}</h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-muted">{t('heart.lead')}</p>
  </div>
</header>

<!-- Causes -->
<section class="px-5 pb-24">
  <div class="mx-auto max-w-5xl">
    <div class="reveal mx-auto mb-10 max-w-2xl text-center">
      <h2 class="text-2xl font-semibold text-text sm:text-3xl">{t('heart.causes')}</h2>
      <p class="mt-3 text-muted">{t('heart.causes.lead')}</p>
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      {
        causes.map((c) => (
          <a href={c.url} target="_blank" rel="noopener" class="card press group reveal flex flex-col p-6">
            <div class="mb-4 flex items-center gap-4">
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl font-display text-lg font-bold text-white" style={`background:${c.tint}`}>{c.mono}</span>
              <div>
                <h3 class="font-display text-lg font-semibold text-text">{c.name}</h3>
                <span class="text-xs font-medium" style={`color:${c.tint}`}>{pick(c.tag, lang)}</span>
              </div>
            </div>
            <p class="flex-1 text-sm leading-relaxed text-muted">{pick(c.desc, lang)}</p>
            <span class="mt-5 inline-flex items-center gap-1.5 border-t border-line pt-4 text-sm font-medium text-muted transition-colors group-hover:text-accent">
              {t('heart.support')} <span class="transition-transform group-hover:translate-x-1">→</span>
            </span>
          </a>
        ))
      }
    </div>
    <p class="reveal mt-6 text-center text-xs text-faint">{t('heart.note')}</p>
  </div>
</section>

<!-- Values -->
<section class="border-t border-line bg-surface/60 px-5 py-24">
  <div class="mx-auto max-w-5xl">
    <div class="reveal mx-auto mb-10 max-w-2xl text-center">
      <h2 class="text-2xl font-semibold text-text sm:text-3xl">{t('heart.values')}</h2>
      <p class="mt-3 text-muted">{t('heart.values.lead')}</p>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        values.map((v) => (
          <article class="card reveal p-6">
            <span class="mb-4 grid h-11 w-11 place-items-center rounded-xl bg-surface-2" style={`color:${ROSE}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-5 w-5">
                {v.icon.split('|').map((p) => <path d={p} stroke-linecap="round" stroke-linejoin="round" />)}
              </svg>
            </span>
            <h3 class="font-display text-lg font-semibold text-text">{pick(v.title, lang)}</h3>
            <p class="mt-2 text-sm text-muted">{pick(v.desc, lang)}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- CTA -->
<section class="px-5 py-24 text-center">
  <div class="mx-auto max-w-2xl">
    <h2 class="reveal text-3xl font-semibold text-text sm:text-4xl">{t('heart.cta.title')}</h2>
    <p class="reveal mx-auto mt-4 max-w-xl text-lg text-muted">{t('heart.cta.lead')}</p>
    <a href={lp('/kontakt')} class="press reveal mt-8 inline-block rounded-full px-7 py-3 text-sm font-medium text-white transition-[filter] hover:brightness-110" style={`background:${ROSE}`}>
      {t('nav.contact')}
    </a>
  </div>
</section>

<style>
  .heart-aura { background: radial-gradient(circle, rgba(244, 63, 94, 0.22), transparent 70%); filter: blur(24px); }
  .heartbeat svg { animation: heartbeat 1.6s ease-in-out infinite; transform-origin: center; filter: drop-shadow(0 6px 20px rgba(244, 63, 94, 0.45)); }
  @keyframes heartbeat {
    0%, 100% { transform: scale(1); }
    14% { transform: scale(1.18); }
    28% { transform: scale(1); }
    42% { transform: scale(1.12); }
    56% { transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) { .heartbeat svg { animation: none; } }
</style>
