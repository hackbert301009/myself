---
import PageHeader from '../PageHeader.astro';
import Icon from '../Icon.astro';
import { getLangFromUrl, useTranslations, pick } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const CAT: Record<string, { de: string; en: string }> = {
  academic: { de: 'Akademisch', en: 'Academic' },
  ml: { de: 'ML / AI', en: 'ML / AI' },
  linux: { de: 'Linux', en: 'Linux' },
  security: { de: 'Security', en: 'Security' },
};

// Category icons (single-path where possible)
const ICON: Record<string, string> = {
  academic: 'M22 10 12 5 2 10l10 5 10-5Z|M6 12v5c0 1 2.7 2.5 6 2.5s6-1.5 6-2.5v-5',
  ml: 'M12 5a3 3 0 0 0-3 3 3 3 0 0 0-1 5.8V16a3 3 0 0 0 6 0M12 5a3 3 0 0 1 3 3 3 3 0 0 1 1 5.8',
  linux: 'M9 3h6l1 6c1.5 2 2 4 2 6a5 5 0 0 1-10 0c0-2 .5-4 2-6l-1-6Z',
  security: 'M12 3 4 6v6c0 5 3.5 8 8 10 4.5-2 8-5 8-10V6l-8-3Z',
};

type Cert = { title: string; issuer: string; year: string; cat: keyof typeof CAT; url?: string };
const certs: Cert[] = [
  { title: 'Juniorstudium Angewandte Mathematik', issuer: 'CAU Kiel', year: '2025', cat: 'academic' },
  { title: 'AI for Medicine', issuer: 'DeepLearning.AI', year: '2026', cat: 'ml', url: 'https://www.deeplearning.ai/courses/ai-for-medicine-specialization/' },
  { title: 'Building an Image Classifier', issuer: 'Coursera', year: '2025', cat: 'ml' },
  { title: 'Time Series Forecasting with Machine Learning', issuer: 'openHPI · Hasso-Plattner-Institut', year: '2025', cat: 'ml' },
  { title: 'Time Series Analysis / Big Data', issuer: 'openHPI · Hasso-Plattner-Institut', year: '2025', cat: 'ml' },
  { title: 'LPIC-1 Linux Administrator', issuer: 'Linux Professional Institute', year: '2025', cat: 'linux' },
  { title: 'Cryptography', issuer: 'Google', year: '2024', cat: 'security' },
  { title: 'Datenschutz / DSGVO-Schulung', issuer: 'Wissto International', year: '2026', cat: 'security' },
];

const publications = [
  {
    title: 'S2P-Net: A Spectral-Spatial Polar Network for Rotation-Invariant Object Recognition in Low-Data Regimes',
    venue: 'arXiv:2605.09667',
    year: '2026',
    url: 'https://arxiv.org/abs/2605.09667',
    desc: {
      de: 'Eine kompakte Deep-Learning-Architektur mit mathematisch garantierter Rotationsinvarianz, ganz ohne Data Augmentation. Mit Vergleich zu klassischen CNNs und experimenteller Auswertung.',
      en: 'A compact deep-learning architecture with mathematically guaranteed rotation invariance, entirely without data augmentation. Includes a comparison to conventional CNNs and experimental evaluation.',
    },
  },
];

const present = [...new Set(certs.map((c) => c.cat))];
const filters = [{ key: 'all', label: t('certs.all') }, ...present.map((c) => ({ key: c, label: pick(CAT[c], lang) }))];
const years = certs.map((c) => parseInt(c.year, 10));
const stats = [
  { v: `${certs.length}`, k: t('certs.stat.total') },
  { v: `${present.length}`, k: t('certs.stat.areas') },
  { v: `${Math.min(...years)}`, k: t('certs.stat.since') },
];
---

<PageHeader label={t('certs.label')} title={t('certs.title')} lead={t('certs.lead')} />

<section class="pb-28">
  <div class="mx-auto max-w-5xl px-5">
    <!-- Stats -->
    <div class="reveal mx-auto mb-12 grid max-w-2xl grid-cols-3 overflow-hidden rounded-2xl border border-line bg-surface">
      {
        stats.map((s, i) => (
          <div class:list={['flex flex-col items-center gap-1 py-7', i > 0 ? 'border-l border-line' : '']}>
            <span class="font-display text-3xl font-semibold text-text sm:text-4xl">{s.v}</span>
            <span class="text-xs font-medium text-faint">{s.k}</span>
          </div>
        ))
      }
    </div>

    <!-- Filter -->
    <div class="reveal mb-8 flex flex-wrap justify-center gap-2">
      {
        filters.map((f, i) => (
          <button
            data-filter={f.key}
            class:list={[
              'filter-btn press rounded-full border px-4 py-1.5 text-sm transition-colors',
              i === 0 ? 'border-accent bg-accent text-white' : 'border-line text-muted hover:text-text',
            ]}
          >
            {f.label}
          </button>
        ))
      }
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        certs.map((cert) => (
          <article class="cert-item card flex flex-col p-6" data-category={cert.cat}>
            <div class="mb-4 flex items-start justify-between">
              <span class="grid h-11 w-11 place-items-center rounded-xl bg-surface-2 text-accent">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-5 w-5">
                  {ICON[cert.cat].split('|').map((p) => <path d={p} stroke-linecap="round" stroke-linejoin="round" />)}
                </svg>
              </span>
              <span class="text-sm font-medium text-faint">{cert.year}</span>
            </div>
            <span class="mb-2 w-fit rounded-full bg-surface-2 px-2.5 py-0.5 text-xs font-medium text-muted">{pick(CAT[cert.cat], lang)}</span>
            <h3 class="font-display text-lg font-semibold leading-snug text-text">{cert.title}</h3>
            <p class="mt-1 flex-1 text-sm text-muted">{cert.issuer}</p>
            {cert.url && (
              <a href={cert.url} rel="noopener" class="mt-4 text-sm font-medium text-accent hover:underline">
                {t('certs.verify')} →
              </a>
            )}
          </article>
        ))
      }
    </div>
    <p id="cert-empty" class="hidden py-16 text-center text-muted">{t('projects.empty')}</p>
  </div>
</section>

<!-- PUBLICATIONS -->
<section class="relative overflow-hidden border-t border-line bg-surface/40 py-20 sm:py-24">
  <div class="relative mx-auto max-w-5xl px-5">
    <div class="reveal mb-10 text-center">
      <p class="label-mono mb-3">{t('certs.pub')}</p>
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{t('certs.pub')}</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-muted">{t('certs.pub.lead')}</p>
    </div>
    <div class="mx-auto grid max-w-3xl gap-5">
      {
        publications.map((pub) => (
          <article class="card reveal p-7 sm:p-8">
            <div class="flex items-start gap-5">
              <span class="hidden h-12 w-12 shrink-0 place-items-center rounded-2xl bg-surface-2 text-accent sm:grid">
                <Icon name="detect" class="h-6 w-6" />
              </span>
              <div class="min-w-0">
                <div class="mb-2 flex flex-wrap items-center gap-3">
                  <span class="font-mono text-xs text-accent">{pub.venue}</span>
                  <span class="font-mono text-xs text-faint">{pub.year}</span>
                </div>
                <h3 class="font-display text-lg font-semibold leading-snug text-text sm:text-xl">{pub.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{pick(pub.desc, lang)}</p>
                <a
                  href={pub.url}
                  target="_blank"
                  rel="noopener"
                  class="press mt-5 inline-flex items-center gap-1.5 rounded-full border border-line-strong px-4 py-1.5 text-sm font-medium text-text transition-colors hover:border-accent hover:text-accent"
                >
                  {t('certs.read')} <Icon name="external" class="h-4 w-4" />
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.cert-item');
  const empty = document.getElementById('cert-empty');
  const setActive = (active: HTMLButtonElement) => {
    btns.forEach((b) => {
      const on = b === active;
      b.classList.toggle('bg-accent', on);
      b.classList.toggle('text-white', on);
      b.classList.toggle('border-accent', on);
      b.classList.toggle('border-line', !on);
      b.classList.toggle('text-muted', !on);
    });
  };
  btns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      setActive(btn);
      let visible = 0;
      items.forEach((item) => {
        const show = f === 'all' || item.dataset.category === f;
        (item as HTMLElement).style.display = show ? '' : 'none';
        if (show) visible++;
      });
      empty?.classList.toggle('hidden', visible > 0);
    });
  });
</script>
