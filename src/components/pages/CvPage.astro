---
import { getCollection } from 'astro:content';
import PageHeader from '../PageHeader.astro';
import { getLangFromUrl, useTranslations, pick } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const experience = [
  {
    period: '2025 — ' + (lang === 'de' ? 'heute' : 'present'),
    org: 'EyeSpec FAW Group',
    role: { de: 'Fachinformatiker Systemintegration', en: 'IT Systems Integration Specialist' },
    desc: {
      de: 'Betrieb und Absicherung von Systemen und Servern, Mitentwicklung interner SaaS-Lösungen und Mitarbeit an Computer-Vision-gestützter Kamerainspektion.',
      en: 'Operating and securing systems and servers, co-developing internal SaaS tools, and contributing to computer-vision-based camera inspection.',
    },
  },
];

const education = [
  {
    period: '2023 — 2025',
    org: 'Christian-Albrechts-Universität zu Kiel',
    role: { de: 'Juniorstudium — Angewandte Mathematik', en: 'Junior studies — Applied Mathematics' },
    desc: {
      de: 'Frühstudium mit Schwerpunkt Informatik und Mathematik parallel zur Schule.',
      en: 'Early university studies focused on computer science and mathematics, alongside school.',
    },
  },
  {
    period: '2025',
    org: 'Realschule St. Michaelisdonn',
    role: { de: 'Schulabschluss (Ø 1,1)', en: 'School diploma (GPA 1.1)' },
    desc: {
      de: 'Schwerpunkt Informatik/Mathematik. Leitung der Computer-AG.',
      en: 'Focus on computer science/mathematics. Led the school computer club.',
    },
  },
];

const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);

const KIND: Record<string, string> = {
  whitepaper: 'Whitepaper',
  competition: lang === 'de' ? 'Wettbewerb' : 'Competition',
  thesis: lang === 'de' ? 'Studium' : 'Studies',
  course: lang === 'de' ? 'Kurs' : 'Course',
  publication: lang === 'de' ? 'Publikation' : 'Publication',
};
---

<PageHeader label={t('cv.label')} title={t('cv.title')} lead={t('cv.lead')} />

<section class="py-16">
  <div class="mx-auto max-w-4xl px-5">
    <!-- Experience -->
    <h2 class="reveal mb-8 flex items-center gap-3 text-2xl font-semibold">
      <span class="label-mono !text-accent">01</span> {t('cv.experience')}
    </h2>
    <ol class="relative mb-16 border-l border-line pl-8">
      {
        experience.map((e) => (
          <li class="reveal relative mb-10 last:mb-0">
            <span class="absolute -left-[2.15rem] top-1 grid h-4 w-4 place-items-center rounded-full border border-accent bg-ink">
              <span class="h-1.5 w-1.5 rounded-full bg-accent" />
            </span>
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="text-lg font-semibold text-text">{pick(e.role, lang)}</h3>
              <span class="font-mono text-xs text-faint">{e.period}</span>
            </div>
            <p class="text-sm text-accent">{e.org}</p>
            <p class="mt-2 text-sm leading-relaxed text-muted">{pick(e.desc, lang)}</p>
          </li>
        ))
      }
    </ol>

    <!-- Education -->
    <h2 class="reveal mb-8 flex items-center gap-3 text-2xl font-semibold">
      <span class="label-mono !text-accent">02</span> {t('cv.education')}
    </h2>
    <ol class="relative mb-16 border-l border-line pl-8">
      {
        education.map((e) => (
          <li class="reveal relative mb-10 last:mb-0">
            <span class="absolute -left-[2.15rem] top-1 grid h-4 w-4 place-items-center rounded-full border border-iris bg-ink">
              <span class="h-1.5 w-1.5 rounded-full bg-iris" />
            </span>
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="text-lg font-semibold text-text">{pick(e.role, lang)}</h3>
              <span class="font-mono text-xs text-faint">{e.period}</span>
            </div>
            <p class="text-sm text-iris-soft">{e.org}</p>
            <p class="mt-2 text-sm leading-relaxed text-muted">{pick(e.desc, lang)}</p>
          </li>
        ))
      }
    </ol>

    <!-- Research -->
    <h2 class="reveal mb-8 flex items-center gap-3 text-2xl font-semibold">
      <span class="label-mono !text-accent">03</span> {t('research.title')}
    </h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        research.map((item) => (
          <article class="card reveal p-5">
            <div class="mb-2 flex items-center justify-between">
              <span class="label-mono !text-iris-soft">{KIND[item.data.kind] ?? item.data.kind}</span>
              <span class="font-mono text-xs text-faint">{item.data.year}</span>
            </div>
            <h3 class="font-semibold text-text">
              {pick(item.data.title, lang)}
              {item.data.needsConfirmation && <span class="ml-1 font-mono text-[0.6rem] text-iris-soft" title="zu bestätigen">ⓘ</span>}
            </h3>
            {item.data.venue && <p class="text-sm text-accent">{item.data.venue}</p>}
            <p class="mt-2 text-sm text-muted">{pick(item.data.summary, lang)}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
