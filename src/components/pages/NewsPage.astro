---
import { getCollection } from 'astro:content';
import PageHeader from '../PageHeader.astro';
import { getLangFromUrl, useTranslations, pick, localizedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const lp = (p: string) => localizedPath(p, lang);

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageHeader label={t('news.label')} title={t('news.title')} lead={t('news.lead')} />

<section class="py-16">
  <div class="mx-auto max-w-4xl px-5">
    <div class="grid gap-5">
      {
        posts.map((post) => (
          <a href={lp(`/aktuelles/${post.id}`)} class="card reveal group flex flex-col gap-3 p-6 sm:flex-row sm:items-center sm:gap-6">
            <div class="shrink-0 sm:w-32">
              <span class="font-mono text-xs text-faint">
                {post.data.date.toLocaleDateString(lang === 'de' ? 'de-DE' : 'en-US', { day: '2-digit', month: 'short', year: 'numeric' })}
              </span>
              <span class="mt-1 block w-fit rounded-md border border-line px-2 py-0.5 font-mono text-[0.6rem] uppercase tracking-wider text-accent">
                {post.data.category}
              </span>
            </div>
            <div class="flex-1">
              <h2 class="font-display text-xl font-semibold text-text transition-colors group-hover:text-accent">
                {pick(post.data.title, lang)}
              </h2>
              <p class="mt-1.5 text-sm text-muted">{pick(post.data.excerpt, lang)}</p>
            </div>
            <span class="hidden text-faint transition-colors group-hover:text-accent sm:block">→</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
