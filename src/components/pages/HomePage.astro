---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Hero from '../Hero.astro';
import ProjectCard from '../ProjectCard.astro';
import VisionLab from '../VisionLab.astro';
import Icon from '../Icon.astro';
import { getLangFromUrl, useTranslations, localizedPath } from '../../i18n/utils';
import portraitImg from '../../assets/portrait.jpg';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const lp = (p: string) => localizedPath(p, lang);

const allProjects = await getCollection('projects');
const featured = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const skills = [
  'Computer Vision', 'PyTorch', 'OpenCV', 'Python', 'Machine Learning', 'Deep Learning',
  'Angewandte Mathematik', 'C / C++', 'ESP32 / Arduino', 'Raspberry Pi', 'Flask / FastAPI',
  'Streamlit', 'Linux', 'Docker', 'Kotlin / Android', 'Git',
];

const affiliations = ['EyeSpec FAW Group', 'Juniorstudium CAU Kiel', 'BWKI 2026', 'SterilVision'];
const stats = [
  { v: `${Math.max(allProjects.length, 1)}`, k: t('home.stats.projects') },
  { v: `${new Set(allProjects.map((p) => p.data.category)).size}`, k: t('home.stats.areas') },
  { v: `${skills.length}`, k: t('home.stats.tech') },
  { v: '2023', k: t('home.stats.since') },
];
const caps = [
  { key: 'cv', icon: 'detect' as const },
  { key: 'embedded', icon: 'chip' as const },
  { key: 'systems', icon: 'stack' as const },
];
---

<Hero />

<!-- CREDIBILITY: affiliations + metrics -->
<section class="relative overflow-hidden border-y border-line bg-surface/50">
  <div class="relative mx-auto max-w-5xl px-5 py-10">
    <p class="reveal mb-6 text-center font-mono text-xs tracking-wide text-faint">{t('home.trust')}</p>
    <div class="reveal mb-10 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-sm font-medium text-muted">
      {
        affiliations.map((a, i) => (
          <>
            {i > 0 && <span class="text-line-strong">/</span>}
            <span>{a}</span>
          </>
        ))
      }
    </div>
    <div class="reveal grid grid-cols-2 gap-y-8 sm:grid-cols-4">
      {
        stats.map((s) => (
          <div class="flex flex-col items-center gap-1 border-line sm:border-l sm:first:border-l-0">
            <span class="font-display text-3xl font-semibold text-text sm:text-4xl">{s.v}</span>
            <span class="font-mono text-xs text-faint">{s.k}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- VISION LAB (signature interactive) -->
<section id="lab" class="relative overflow-hidden py-24 sm:py-32">
  <div class="relative mx-auto max-w-5xl px-5">
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.05fr]">
      <div class="reveal">
        <p class="label-mono mb-3 flex items-center gap-2">
          <span style="color: var(--color-scan)"><Icon name="scan" class="h-4 w-4" /></span>
          {t('lab.label')}
        </p>
        <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{t('lab.title')}</h2>
        <p class="mt-5 text-lg leading-relaxed text-muted">{t('lab.lead')}</p>
        <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 font-mono text-sm text-muted">
          <li class="flex items-center gap-2"><Icon name="scan" class="h-4 w-4" />Scan / Spotlight</li>
          <li class="flex items-center gap-2"><Icon name="kernel" class="h-4 w-4" />Sobel</li>
          <li class="flex items-center gap-2"><Icon name="detect" class="h-4 w-4" />Threshold</li>
        </ul>
      </div>
      <div class="reveal">
        <VisionLab />
      </div>
    </div>
  </div>
</section>

<!-- ABOUT -->
<section id="about" class="border-t border-line py-24 sm:py-32">
  <div class="mx-auto max-w-5xl px-5">
    <div class="grid items-center gap-12 md:grid-cols-[0.8fr_1.2fr]">
      <div class="reveal mx-auto w-full max-w-xs">
        <div class="overflow-hidden rounded-3xl border border-line shadow-[var(--shadow-soft)]">
          <Image src={portraitImg} alt="Albert Heruth" widths={[320, 480, 640]} class="w-full" />
        </div>
      </div>

      <div class="reveal">
        <p class="label-mono mb-3">{t('about.label')}</p>
        <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{t('about.title')}</h2>
        <p class="mt-5 text-lg leading-relaxed text-muted">{t('about.p1')}</p>
        <p class="mt-4 text-lg leading-relaxed text-muted">{t('about.p2')}</p>

        <p class="mt-6 text-base leading-relaxed text-text">{t('about.philosophy.p')}</p>

        <div class="mt-7 flex flex-wrap gap-2">
          {
            skills.map((s) => (
              <span class="rounded-full border border-line bg-surface px-3.5 py-1.5 font-mono text-[0.78rem] text-muted">
                {s}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CAPABILITIES -->
<section class="relative overflow-hidden border-t border-line bg-surface/40 py-24 sm:py-32">
  <div class="relative mx-auto max-w-5xl px-5">
    <div class="reveal mb-12 text-center">
      <p class="label-mono mb-3">{t('home.caps.label')}</p>
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{t('home.caps.title')}</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-muted">{t('home.caps.lead')}</p>
    </div>
    <div class="grid gap-6 sm:grid-cols-3">
      {
        caps.map((c, i) => (
          <article class="card reveal flex flex-col p-7">
            <div class="mb-5 flex items-center justify-between">
              <span class="grid h-12 w-12 place-items-center rounded-2xl bg-surface-2 text-accent">
                <Icon name={c.icon} class="h-6 w-6" />
              </span>
              <span class="font-mono text-xs text-faint">0{i + 1}</span>
            </div>
            <h3 class="font-display text-lg font-semibold text-text">{t(`home.caps.${c.key}` as any)}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{t(`home.caps.${c.key}.desc` as any)}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- SELECTED PROJECTS -->
<section id="projects" class="border-t border-line py-24 sm:py-32">
  <div class="mx-auto max-w-5xl px-5">
    <div class="reveal mb-12 text-center">
      <p class="label-mono mb-3">{t('home.featured')}</p>
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{t('home.featured.title')}</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-muted">{t('home.featured.lead')}</p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((project) => <ProjectCard project={project} lang={lang} />)}
    </div>
    <div class="mt-12 text-center">
      <a
        href={lp('/projekte')}
        class="press inline-flex items-center gap-2 rounded-full border border-line-strong px-6 py-2.5 text-sm font-medium text-text transition-colors hover:border-accent hover:text-accent"
      >
        {t('home.viewall')} <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>

<!-- CONTACT CTA -->
<section class="relative overflow-hidden border-t border-line py-24 sm:py-32">
  <div class="relative mx-auto max-w-2xl px-5 text-center">
    <h2 class="reveal text-3xl font-semibold tracking-tight sm:text-4xl">{t('home.cta.title')}</h2>
    <p class="reveal mx-auto mt-4 max-w-xl text-lg text-muted">{t('home.cta.lead')}</p>
    <a
      href={lp('/kontakt')}
      class="press reveal mt-8 inline-block rounded-full bg-accent px-7 py-3 text-sm font-medium text-white transition-[filter] hover:brightness-110"
    >
      {t('hero.cta.contact')}
    </a>
  </div>
</section>
