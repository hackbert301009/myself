---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { pick } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
}
const { project, lang } = Astro.props;
const { title, summary, repo, demo, cover } = project.data;

const primary = demo ?? repo;
const linkAttrs = primary ? { href: primary, target: '_blank', rel: 'noopener noreferrer' } : {};
const Tag = primary ? 'a' : 'div';
---

<Tag {...linkAttrs} class="card reveal group flex flex-col overflow-hidden">
  {
    cover ? (
      <div class="aspect-[16/10] overflow-hidden bg-surface-2">
        <Image
          src={cover}
          alt={title}
          widths={[400, 800, 1200]}
          sizes="(max-width: 768px) 100vw, 33vw"
          class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
        />
      </div>
    ) : (
      <div class="flex aspect-[16/10] items-center justify-center bg-surface-2">
        <span class="text-4xl font-semibold text-faint">{title.charAt(0)}</span>
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-lg font-semibold text-text">{title}</h3>
    <p class="mt-2 flex-1 text-[0.95rem] leading-relaxed text-muted">{pick(summary, lang)}</p>
    {
      primary && (
        <div class="mt-4 text-sm font-medium text-accent">
          <span class="transition-opacity group-hover:opacity-80">
            {demo ? (lang === 'de' ? 'Ansehen' : 'View') : 'Code'} →
          </span>
        </div>
      )
    }
  </div>
</Tag>
