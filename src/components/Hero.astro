---
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const lp = (p: string) => localizedPath(p, lang);

const line1 = t('hero.title.1');
const line2 = t('hero.title.2');

const socials = [
  {
    href: 'mailto:albert.heruth@gmail.com',
    label: 'E-Mail',
    icon: 'M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Z|m4 7 8 6 8-6',
    ext: false,
  },
  {
    href: 'https://github.com/hackbert301009',
    label: 'GitHub',
    icon: 'M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z',
    ext: true,
  },
  {
    href: 'https://www.linkedin.com/in/albert-heruth-37aa74379/',
    label: 'LinkedIn',
    icon: 'M4.98 3.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM3 9h4v12H3zM10 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.75-1.95 4 0 4.4 2.5 4.4 5.8V21h-4v-5.2c0-1.24-.02-2.84-1.75-2.84s-2 1.35-2 2.75V21h-4z',
    ext: true,
  },
  {
    href: 'tel:+4915204277531',
    label: 'Telefon',
    icon: 'M6.6 2.5c.5 0 .95.3 1.14.77l1.2 3a1.25 1.25 0 0 1-.3 1.38L7.3 8.98a12 12 0 0 0 5.72 5.72l1.33-1.34a1.25 1.25 0 0 1 1.38-.3l3 1.2c.47.2.77.64.77 1.15V19a2.5 2.5 0 0 1-2.7 2.5A16.5 16.5 0 0 1 2.5 6.7 2.5 2.5 0 0 1 5 4Z',
    ext: false,
  },
];
---

<section class="relative flex min-h-[100svh] flex-col items-center justify-center px-5 text-center">
  <p class="reveal is-visible label-mono mb-5">{t('hero.role')}</p>

  <h1 class="max-w-4xl text-4xl font-semibold leading-[1.06] tracking-tight text-text sm:text-6xl md:text-7xl">
    <span id="hero-type" data-l1={line1} data-l2={line2}>
      <span class="block">{line1}</span>
      <span class="block text-muted">{line2}</span>
    </span>
  </h1>

  <p class="reveal is-visible mx-auto mt-7 max-w-xl text-lg leading-relaxed text-muted">
    {t('hero.lead')}
  </p>

  <div class="reveal is-visible mt-9 flex flex-wrap items-center justify-center gap-3">
    <a
      href={lp('/projekte')}
      class="press rounded-full bg-accent px-6 py-2.5 text-sm font-medium text-white transition-[filter] hover:brightness-110"
    >
      {t('hero.cta.work')}
    </a>
    <a
      href={lp('/kontakt')}
      class="press rounded-full border border-line-strong px-6 py-2.5 text-sm font-medium text-text transition-colors hover:border-accent hover:text-accent"
    >
      {t('hero.cta.contact')}
    </a>
  </div>

  <!-- Floating social drawer -->
  <div class="fixed inset-x-0 bottom-5 z-30 flex justify-center px-5">
    <div class="glass flex items-center gap-1 rounded-full border border-line px-2 py-1.5 shadow-[var(--shadow-soft)]">
      {
        socials.map((s) => (
          <a
            href={s.href}
            target={s.ext ? '_blank' : undefined}
            rel={s.ext ? 'me noopener noreferrer' : 'me'}
            aria-label={s.label}
            title={s.label}
            class="press grid h-10 w-10 place-items-center rounded-full text-muted transition-colors hover:bg-surface hover:text-accent"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              {s.icon.split('|').map((d) => (
                <path d={d} />
              ))}
            </svg>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const wrap = document.getElementById('hero-type');
    if (!wrap) return;
    const l1 = wrap.getAttribute('data-l1') || '';
    const l2 = wrap.getAttribute('data-l2') || '';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const spanTop = document.createElement('span');
    spanTop.className = 'block';
    const spanBottom = document.createElement('span');
    spanBottom.className = 'block text-muted';
    const caret = document.createElement('span');
    caret.className = 'caret';
    caret.style.height = '0.9em';
    caret.setAttribute('aria-hidden', 'true');

    wrap.innerHTML = '';
    wrap.append(spanTop, spanBottom);
    spanTop.appendChild(caret);

    let i = 0;
    const typeLine = (el, text, done) => {
      const step = () => {
        if (i <= text.length) {
          el.textContent = text.slice(0, i);
          el.appendChild(caret);
          i++;
          setTimeout(step, 45);
        } else {
          i = 0;
          done();
        }
      };
      step();
    };

    typeLine(spanTop, l1, () => {
      typeLine(spanBottom, l2, () => {
        // caret stays blinking on the final line
      });
    });
  })();
</script>
